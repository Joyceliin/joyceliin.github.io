---
import { routes, ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** Mesma página no outro idioma (seletor de idioma). */
  alt: string;
}

const { lang, alt } = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;

const links = [
  { href: routes.about[lang], label: t.nav.about },
  { href: routes.projects[lang], label: t.nav.projects },
  { href: routes.contact[lang], label: t.nav.contact },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={routes.home[lang]} aria-label={`Joyce Nogueira, ${t.homeLabel}`}
      ><span class="brand__full">Joyce Nogueira</span><span class="brand__short" aria-hidden="true">JN</span></a
    >
    <nav aria-label={t.navLabel}>
      <ul class="nav">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={pathname.startsWith(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="lang-switch" href={alt} hreflang={lang === "pt" ? "en" : "pt-BR"} aria-label={t.switchLabel}>
            {t.switchTo}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
