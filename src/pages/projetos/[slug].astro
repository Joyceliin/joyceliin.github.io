---
import ProjectDetail from "../../views/ProjectDetail.astro";
import { getProjects } from "../../data/projects";

export async function getStaticPaths() {
  const projects = await getProjects("pt");
  return projects.map((project) => ({ params: { slug: project.caseSlug }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectDetail lang="pt" project={project} />
