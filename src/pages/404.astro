---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página não encontrada · Page not found" alt="/en/">
  <header class="page-intro">
    <p class="eyebrow">404</p>
    <h1 class="page-intro__title">Essa página não existe</h1>
    <p class="page-intro__lead">
      O endereço pode ter mudado: alguns cases foram reorganizados.
      <br /><span lang="en">This page does not exist. Some case studies were reorganized.</span>
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/">Ir para o início</a>
      <a class="btn btn--ghost" href="/projetos/">Ver cases</a>
      <a class="btn btn--link" href="/en/" lang="en">English version</a>
    </div>
  </header>
</BaseLayout>
